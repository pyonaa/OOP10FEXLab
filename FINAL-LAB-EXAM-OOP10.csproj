<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FINAL_LAB_EXAM_OOP10</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>

	<ItemGroup>
		<Compile Update="KioskForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Properties\Resources.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="QueueMonitorForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="QueueMonitorForm.Designer.cs">
			<DependentUpon>QueueMonitorForm.cs</DependentUpon>
		</Compile>
		<Compile Update="ReviewOrderForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="ReviewOrderForm.Designer.cs">
			<DependentUpon>ReviewOrderForm.cs</DependentUpon>
		</Compile>
		<Compile Update="MealCard.cs">
			<SubType>UserControl</SubType>
		</Compile>
		<Compile Update="MealCard.Designer.cs">
			<DependentUpon>MealCard.cs</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>